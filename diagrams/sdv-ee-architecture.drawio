        <mxCell id="net20" value="VXLAN&lt;br&gt;inter-host overlay" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B06000;strokeWidth=1.5;fontSize=12;fontColor=#7A4100;" vertex="1" parent="b_net"><mxGeometry x="20" y="132" width="270" height="72" as="geometry" /></mxCell>
        <mxCell id="net21" value="WireGuard&lt;br&gt;telemetry &amp; OTA transport" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B06000;strokeWidth=1.5;fontSize=12;fontColor=#7A4100;" vertex="1" parent="b_net"><mxGeometry x="310" y="132" width="270" height="72" as="geometry" /></mxCell>
        <mxCell id="net22" value="FRR — BGP&lt;br&gt;cloud interconnect" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B06000;strokeWidth=1.5;fontSize=12;fontColor=#7A4100;" vertex="1" parent="b_net"><mxGeometry x="600" y="132" width="270" height="72" as="geometry" /></mxCell>
        <mxCell id="net23" value="nftables&lt;br&gt;per VLAN / per slice" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B06000;strokeWidth=1.5;fontSize=12;fontColor=#7A4100;" vertex="1" parent="b_net"><mxGeometry x="890" y="132" width="270" height="72" as="geometry" /></mxCell>
        <mxCell id="net24" value="Open5GS + UERANSIM&lt;br&gt;real S-NSSAI slicing (H2)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B06000;strokeWidth=1.5;fontSize=12;fontColor=#7A4100;" vertex="1" parent="b_net"><mxGeometry x="1180" y="132" width="270" height="72" as="geometry" /></mxCell>
        <mxCell id="net25" value="FD.io VPP (DPDK) variant&lt;br&gt;minimal latency variance" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B06000;strokeWidth=1.5;fontSize=12;fontColor=#7A4100;" vertex="1" parent="b_net"><mxGeometry x="1470" y="132" width="270" height="72" as="geometry" /></mxCell>
        <mxCell id="slices" value="SLICES (network.slices[])   adas — vlan 101, min 100 / max 200 Mb/s, prio 1   ·   infotainment — vlan 102, capped   ·   ota — vlan 103   ·   telemetry — vlan 104     |     mode: vlan (H1, static)  ↔  mode: s-nssai (H2, real 5G)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFECB3;strokeColor=#E65100;strokeWidth=1.5;fontSize=12;fontColor=#7A2E00;" vertex="1" parent="b_net"><mxGeometry x="20" y="216" width="1720" height="54" as="geometry" /></mxCell>
        <mxCell id="b_host" value="Host platform (determinism controls)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#546E7A;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#37474F;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="100" y="1530" width="1760" height="81" as="geometry" /></mxCell>
        <mxCell id="host" value="NVIDIA GPU host(s)  —  Linux PREEMPT_RT  ·  isolcpus / cpuset-pinned forwarding cores  ·  hugepages  ·  KVM  ·  DCGM/NVML GPU telemetry (utilisation, VRAM boundaries, thermal/power throttling)     |     phase-4 exit ramp: BlueField DPU / ConnectX offload via DOCA, DRIVE AGX" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#607D8B;strokeWidth=1.5;fontSize=12;fontColor=#263238;" vertex="1" parent="b_host"><mxGeometry x="20" y="34" width="1720" height="38" as="geometry" /></mxCell>
        <mxCell id="cpb" value="vxedge CONTROL PLANE &amp; TOOLING  (API-first — no orchestration logic in any frontend)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F3F4FB;strokeColor=#3949AB;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#1A237E;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1900" y="210" width="420" height="1401" as="geometry" /></mxCell>
        <mxCell id="cp_cli" value="vxedge CLI (Rust) — thin vxAPI client&lt;br&gt;up | down | status · --endpoint for remote" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3949AB;strokeWidth=1.5;fontSize=12;fontColor=#1A237E;" vertex="1" parent="cpb"><mxGeometry x="16" y="70" width="388" height="62" as="geometry" /></mxCell>
        <mxCell id="cp_fe" value="Frontends: Qt/QML (+WASM) · TypeScript web · Electron&lt;br&gt;desktop/researcher tooling for OEM engineers" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3949AB;strokeWidth=1.5;fontSize=12;fontColor=#1A237E;" vertex="1" parent="cpb"><mxGeometry x="16" y="146" width="388" height="62" as="geometry" /></mxCell>
        <mxCell id="cp_api" value="vxAPI — gRPC / Protobuf IDL, package vxedge.v1&lt;br&gt;vxedge/vxedge/proto/ · all SDKs generated, never hand-written" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3949AB;strokeWidth=1.5;fontSize=12;fontColor=#1A237E;" vertex="1" parent="cpb"><mxGeometry x="16" y="222" width="388" height="62" as="geometry" /></mxCell>
        <mxCell id="cp_daemon" value="vxedged — control-plane daemon&lt;br&gt;orchestration + provisioning core · UDS by default, HTTPS remote&lt;br&gt;--controller federates site daemons (cloud-hostable)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3949AB;strokeWidth=1.5;fontSize=12;fontColor=#1A237E;" vertex="1" parent="cpb"><mxGeometry x="16" y="298" width="388" height="80" as="geometry" /></mxCell>
        <mxCell id="cp_core" value="vxedge-core — domain library&lt;br&gt;manifest model · validation · provisioning templates" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3949AB;strokeWidth=1.5;fontSize=12;fontColor=#1A237E;" vertex="1" parent="cpb"><mxGeometry x="16" y="392" width="388" height="62" as="geometry" /></mxCell>
        <mxCell id="cp_man" value="MANIFESTS (YAML) — the sole execution contract&lt;br&gt;vehicle.yaml (§6.2) · exp-NNN.yaml (§6.1)&lt;br&gt;versioned · images pinned by SHA256 digest · idempotent up|down" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3949AB;strokeWidth=1.5;fontSize=12;fontColor=#1A237E;" vertex="1" parent="cpb"><mxGeometry x="16" y="468" width="388" height="80" as="geometry" /></mxCell>
        <mxCell id="cp_model" value="vxmodels — SysML v2 (track M)&lt;br&gt;design authority upstream of manifests · vxmodel render → YAML + model digest&lt;br&gt;requirements H1–H4 verify-linked to frozen result archives" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3949AB;strokeWidth=1.5;fontSize=12;fontColor=#1A237E;" vertex="1" parent="cpb"><mxGeometry x="16" y="562" width="388" height="92" as="geometry" /></mxCell>
        <mxCell id="cp_svc" value="SERVICES (services[])&lt;br&gt;vxota — OTA server, signing, artifact store (H4)&lt;br&gt;vxtelemetry — ingestion → Prometheus export (VSS-aligned)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3949AB;strokeWidth=1.5;fontSize=12;fontColor=#1A237E;" vertex="1" parent="cpb"><mxGeometry x="16" y="668" width="388" height="80" as="geometry" /></mxCell>
        <mxCell id="cp_agents" value="AGENTS (vxagents, Rust — lightweight by design)&lt;br&gt;vxprobe (latency/jitter/loss) · vxtraffic (load) · vxplant (plant model)&lt;br&gt;optional PCAP capture (telemetry.pcap)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3949AB;strokeWidth=1.5;fontSize=12;fontColor=#1A237E;" vertex="1" parent="cpb"><mxGeometry x="16" y="762" width="388" height="80" as="geometry" /></mxCell>
        <mxCell id="cp_orch" value="In-vehicle workload orchestration (phase 3)&lt;br&gt;Eclipse Ankaios / BlueChi — mirrors production SDV runtimes" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3949AB;strokeWidth=1.5;fontSize=12;fontColor=#1A237E;" vertex="1" parent="cpb"><mxGeometry x="16" y="856" width="388" height="62" as="geometry" /></mxCell>
        <mxCell id="cp_res" value="RESULTS (results.artifact_dir)&lt;br&gt;vxedge telemetry collect --out results/&lt;exp&gt;.zip&lt;br&gt;p50/p95/p99 latency · jitter · loss per slice · OTA success/latency" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3949AB;strokeWidth=1.5;fontSize=12;fontColor=#1A237E;" vertex="1" parent="cpb"><mxGeometry x="16" y="932" width="388" height="80" as="geometry" /></mxCell>
        <mxCell id="cp_run" value="RUN SEQUENCE&lt;br&gt;edge up → zones up → compute up → services up (ota, telemetry)&lt;br&gt;→ experiment up → collect → tear down in reverse" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3949AB;strokeWidth=1.5;fontSize=12;fontColor=#1A237E;" vertex="1" parent="cpb"><mxGeometry x="16" y="1026" width="388" height="80" as="geometry" /></mxCell>
        <mxCell id="cp_note" value="Extension rule — a new capability lands as: (1) ARCHITECTURE.md schema change, (2) vxAPI proto change, (3) manifest field, (4) backend in vxedged. New services plug in as vxsvc-* repos referenced from services[]; no bespoke ad-hoc RPC is permitted." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#FBC02D;strokeWidth=1;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;fontColor=#5D4037;" vertex="1" parent="cpb"><mxGeometry x="16" y="1120" width="388" height="110" as="geometry" /></mxCell>
        <mxCell id="cp_repos" value="REPOS: docs · vxedge (core/daemon/CLI/proto) · vxzones · vxcompute · vxota · vxagents · vxtelemetry · vxperiments · vxmodels" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#FBC02D;strokeWidth=1;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;fontColor=#5D4037;" vertex="1" parent="cpb"><mxGeometry x="16" y="1244" width="388" height="84" as="geometry" /></mxCell>
