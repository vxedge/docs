        <mxCell id="cpe_cp_man_cp_core" value="sole input" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#3949AB;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=11;fontColor=#1A237E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cp_man" target="cp_core"><mxGeometry relative="1" as="geometry" /></mxCell>
