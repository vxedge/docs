        <mxCell id="t1" value="vxedge — next-generation SDV zonal E/E architecture · hardware perspective" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="100" y="100" width="1700" height="46" as="geometry" /></mxCell>
        <mxCell id="t1s" value="Blocks = physical/virtualised hardware entities · connectors = physical link types. Every element is a manifest object: zones/nodes → docs/ARCHITECTURE.md §6.1 zones[], connectors → §6.1 links[] (the wiring harness), slices → §6.1 network.slices. In vxedge each block is realised in software (QEMU/KVM guest, netns, or container) on the host — no physical router or ECU anywhere." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#546E7A;" vertex="1" parent="1"><mxGeometry x="100" y="152" width="1760" height="46" as="geometry" /></mxCell>
        <mxCell id="cloud" value="Off-board — operator edge / cloud (optional; vxedged --controller federates site daemons)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#546E7A;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#37474F;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="100" y="210" width="1760" height="108" as="geometry" /></mxCell>
