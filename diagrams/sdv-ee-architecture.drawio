        <object id="canbus" label="BODY CAN-FD / LIN BACKBONE  (legacy bus edges, type: can)  —  SocketCAN vcan per zone, tunnelled across the Ethernet backbone with cannelloni; CAN frames ↔ VSS signals via Kuksa feeders" kind="link" type="can" spec="ARCHITECTURE.md#7--network-model--vxgateway-sdn-slicing"><mxCell style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#7A2E00;" vertex="1" parent="veh"><mxGeometry x="40" y="1040" width="1680" height="50" as="geometry" /></mxCell></object>
        <mxCell id="can_rl" value="CAN-FD 500 kb/s (via ZCU-RL)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#E65100;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=11;fontColor=#7A2E00;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="zrl" target="canbus"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="can_rr" value="CAN-FD 500 kb/s (via ZCU-RR)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#E65100;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=11;fontColor=#7A2E00;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="zrr" target="canbus"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="can_hpc" value="gateway routing" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#E65100;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=11;fontColor=#7A2E00;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="zhpc" target="canbus"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="vnote" value="FIDELITY &amp; SCOPE (stated honestly, per project convention) — Perception sensors are synthesised by the world simulator (CARLA / AlpaSim) and ride slice traffic through vxgateway, not GMSL serdes; body sensors/actuators are restbus simulation (DBC ↔ VSS) closed by the vxplant agent; register-level I/O uses QEMU device models or Renode for MCU-class nodes. Production zonal controllers invert the stacking (Type-1 hypervisor on silicon); here KVM is the hypervisor and QNX is a guest — see the hypervisor fidelity ladder, ARCHITECTURE.md §9. Power distribution is modelled only as VSS signals; electrical/thermal fidelity is out of scope." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#FBC02D;strokeWidth=1;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;fontColor=#5D4037;" vertex="1" parent="veh"><mxGeometry x="40" y="1122" width="1680" height="96" as="geometry" /></mxCell>
