  <diagram id="vxedge-ee-hw" name="1 — Hardware (physical E/E)">
    <mxGraphModel adaptiveColors="auto" dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2420" pageHeight="1711" math="0" shadow="0">
